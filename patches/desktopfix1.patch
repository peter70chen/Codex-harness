@@ -0,0 +1,57 @@
+package cliproxy
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// A proxy registry update must not remove a model advertised by the user's
+// native Codex account. Preserve upstream metadata and append only missing GPTs.
+func desktopNativeModels(auth *coreauth.Auth, models []*ModelInfo) []*ModelInfo {
+	if os.Getenv("CODEX_DESKTOP_COMPAT") != "1" || auth == nil || auth.Provider != "codex" || auth.Metadata["desktop_native_auth"] != true {
+		return models
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return models
+	}
+	data, err := os.ReadFile(filepath.Join(home, ".codex", "models_cache.json"))
+	if err != nil {
+		return models
+	}
+	var cache struct {
+		Models []struct {
+			Slug      string `json:"slug"`
+			Display   string `json:"display_name"`
+			Context   int    `json:"context_window"`
+			Reasoning []struct {
+				Effort string `json:"effort"`
+			} `json:"supported_reasoning_levels"`
+		} `json:"models"`
+	}
+	if json.Unmarshal(data, &cache) != nil {
+		return models
+	}
+	seen := map[string]bool{}
+	for _, m := range models {
+		seen[m.ID] = true
+	}
+	out := append([]*ModelInfo(nil), models...)
+	for _, m := range cache.Models {
+		if !strings.HasPrefix(m.Slug, "gpt-") || seen[m.Slug] {
+			continue
+		}
+		levels := []string{}
+		for _, r := range m.Reasoning {
+			levels = append(levels, r.Effort)
+		}
+		out = append(out, &ModelInfo{ID: m.Slug, Object: "model", OwnedBy: "openai", Type: "codex", DisplayName: m.Display, ContextLength: m.Context, Thinking: &registry.ThinkingSupport{Levels: levels}})
+		seen[m.Slug] = true
+	}
+	return out
+}
