diff --git a/internal/runtime/executor/helps/desktop_responses_compat.go b/internal/runtime/executor/helps/desktop_responses_compat.go
new file mode 100644
index 0000000..63397bb
--- /dev/null
+++ b/internal/runtime/executor/helps/desktop_responses_compat.go
@@ -0,0 +1,308 @@
+package helps
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+	"github.com/tiktoken-go/tokenizer"
+)
+
+// DesktopResponsesCompat is opt-in, request-local compatibility for the two
+// configured providers. Billing is published by the executor BEFORE this layer.
+type DesktopResponsesCompat struct {
+	model    string
+	request  []byte
+	names    map[string][2]string
+	hosted   bool
+	finished bool
+}
+
+func NewDesktopResponsesCompat(model string, original, translated []byte) *DesktopResponsesCompat {
+	if os.Getenv("CODEX_DESKTOP_COMPAT") != "1" || (model != "grok-4.6" && model != "muse-spark-1.3-contributor") {
+		return nil
+	}
+	s := &DesktopResponsesCompat{model: model, request: bytes.Clone(translated), names: make(map[string][2]string)}
+	if model == "muse-spark-1.3-contributor" {
+		// Match only tools actually declared in this request. Never split an
+		// arbitrary dotted name or overwrite an explicit upstream namespace.
+		rootNames := make(map[string]bool)
+		for _, tool := range gjson.GetBytes(original, "tools").Array() {
+			if tool.Get("type").String() != "namespace" {
+				rootNames[tool.Get("name").String()] = true
+			}
+		}
+		for _, ns := range gjson.GetBytes(original, "tools").Array() {
+			if ns.Get("type").String() != "namespace" {
+				continue
+			}
+			for _, tool := range ns.Get("tools").Array() {
+				n, f := ns.Get("name").String(), tool.Get("name").String()
+				if n != "" && f != "" && !rootNames[n+"."+f] {
+					s.names[n+"."+f] = [2]string{n, f}
+				}
+			}
+		}
+	}
+	return s
+}
+
+func (s *DesktopResponsesCompat) Apply(payload []byte) []byte {
+	if s == nil {
+		return payload
+	}
+	trimmed := bytes.TrimSpace(payload)
+	if len(trimmed) > 0 && trimmed[0] == '{' {
+		return s.applyJSON(trimmed)
+	}
+	lines := bytes.Split(payload, []byte("\n"))
+	changed := false
+	for i, line := range lines {
+		if !bytes.HasPrefix(line, []byte("data:")) {
+			continue
+		}
+		data := bytes.TrimSpace(line[5:])
+		if !gjson.ValidBytes(data) {
+			continue
+		}
+		updated := s.applyJSON(data)
+		if !bytes.Equal(updated, data) {
+			lines[i] = append([]byte("data: "), updated...)
+			changed = true
+		}
+	}
+	if changed {
+		return bytes.Join(lines, []byte("\n"))
+	}
+	return payload
+}
+
+func (s *DesktopResponsesCompat) normalizeItem(data []byte, path string) []byte {
+	item := gjson.GetBytes(data, path)
+	if item.Get("type").String() == "web_search_call" {
+		s.hosted = true
+	}
+	if item.Get("type").String() != "function_call" {
+		return data
+	}
+	// Empty arguments mean an empty object, not an invalid JSON document.
+	// Do this only on completed items, never on the streaming placeholder.
+	if s.model == "muse-spark-1.3-contributor" && gjson.GetBytes(data, "type").String() != "response.output_item.added" && strings.TrimSpace(item.Get("arguments").String()) == "" {
+		data, _ = sjson.SetBytes(data, path+".arguments", "{}")
+	}
+	if item.Get("namespace").String() != "" {
+		return data
+	}
+	if name, ok := s.names[item.Get("name").String()]; ok {
+		data, _ = sjson.SetBytes(data, path+".namespace", name[0])
+		data, _ = sjson.SetBytes(data, path+".name", name[1])
+	}
+	return data
+}
+
+func (s *DesktopResponsesCompat) applyJSON(data []byte) []byte {
+	if !gjson.ValidBytes(data) {
+		return data
+	}
+	kind := gjson.GetBytes(data, "type").String()
+	if s.model == "muse-spark-1.3-contributor" && kind == "response.function_call_arguments.done" {
+		if strings.TrimSpace(gjson.GetBytes(data, "arguments").String()) == "" {
+			data, _ = sjson.SetBytes(data, "arguments", "{}")
+		}
+		if name, ok := s.names[gjson.GetBytes(data, "name").String()]; ok && gjson.GetBytes(data, "namespace").String() == "" {
+			data, _ = sjson.SetBytes(data, "namespace", name[0])
+			data, _ = sjson.SetBytes(data, "name", name[1])
+		}
+	}
+	if kind == "response.output_item.added" || kind == "response.output_item.done" {
+		data = s.normalizeItem(data, "item")
+	}
+	if kind != "response.completed" && kind != "response.incomplete" {
+		return data
+	}
+	for i := range gjson.GetBytes(data, "response.output").Array() {
+		data = s.normalizeItem(data, "response.output."+strconv.Itoa(i))
+	}
+	if s.finished {
+		return data
+	}
+	s.finished = true
+	usage := gjson.GetBytes(data, "response.usage")
+	providerInput, output := usage.Get("input_tokens").Int(), usage.Get("output_tokens").Int()
+	if !s.hosted || providerInput <= 0 {
+		return data
+	}
+	estimate, ok := estimateDesktopInput(s.request)
+	// Do not replace a plausible provider count. Normalize only a clear
+	// cumulative server-tool count, retaining headroom and the original usage.
+	if !ok || providerInput <= estimate+estimate/4 {
+		return data
+	}
+	data, _ = sjson.SetRawBytes(data, "response.provider_usage", []byte(usage.Raw))
+	data, _ = sjson.SetBytes(data, "response.context_usage", map[string]any{
+		"estimated": true, "method": "max(cl100k,o200k) serialized request + 20% + 4096 framing reserve",
+		"input_tokens": estimate, "reason": "hosted_tool_cumulative_usage",
+	})
+	data, _ = sjson.SetBytes(data, "response.usage.input_tokens", estimate)
+	data, _ = sjson.SetBytes(data, "response.usage.total_tokens", estimate+output)
+	cached := min(usage.Get("input_tokens_details.cached_tokens").Int(), estimate)
+	data, _ = sjson.SetBytes(data, "response.usage.input_tokens_details.cached_tokens", cached)
+	if usage.Get("input_tokens_details.cache_write_tokens").Exists() {
+		data, _ = sjson.SetBytes(data, "response.usage.input_tokens_details.cache_write_tokens", min(usage.Get("input_tokens_details.cache_write_tokens").Int(), estimate-cached))
+	}
+	DesktopDiagnostic(map[string]any{"event": "context_usage_normalized", "model": s.model,
+		"provider_input_tokens": providerInput, "provider_output_tokens": output,
+		"provider_total_tokens": usage.Get("total_tokens").Int(), "provider_cached_tokens": usage.Get("input_tokens_details.cached_tokens").Int(),
+		"context_input_estimate": estimate, "request_bytes": len(s.request)})
+	return data
+}
+
+var desktopCodecs struct {
+	sync.Once
+	codecs []tokenizer.Codec
+}
+
+func estimateDesktopInput(body []byte) (int64, bool) {
+	root := gjson.ParseBytes(body)
+	if root.Get("previous_response_id").String() != "" {
+		return 0, false
+	}
+	// Hidden multimodal tokenization cannot safely be inferred from text.
+	var unsupported func(gjson.Result) bool
+	unsupported = func(v gjson.Result) bool {
+		if v.IsObject() {
+			switch v.Get("type").String() {
+			case "input_image", "input_audio", "input_video", "item_reference", "compaction":
+				return true
+			}
+		}
+		found := false
+		v.ForEach(func(_, value gjson.Result) bool {
+			if (value.IsArray() || value.IsObject()) && unsupported(value) {
+				found = true
+				return false
+			}
+			return true
+		})
+		return found
+	}
+	if unsupported(root.Get("input")) {
+		return 0, false
+	}
+	visible := make(map[string]json.RawMessage)
+	for _, key := range []string{"instructions", "input", "tools", "text"} {
+		if v := root.Get(key); v.Exists() {
+			visible[key] = json.RawMessage(v.Raw)
+		}
+	}
+	if len(visible) == 0 {
+		return 0, false
+	}
+	serialized, err := json.Marshal(visible)
+	if err != nil {
+		return 0, false
+	}
+	desktopCodecs.Do(func() {
+		for _, encoding := range []tokenizer.Encoding{tokenizer.Cl100kBase, tokenizer.O200kBase} {
+			if codec, err := tokenizer.Get(encoding); err == nil {
+				desktopCodecs.codecs = append(desktopCodecs.codecs, codec)
+			}
+		}
+	})
+	if len(desktopCodecs.codecs) != 2 {
+		return 0, false
+	}
+	var count int64
+	for _, codec := range desktopCodecs.codecs {
+		n, err := codec.Count(string(serialized))
+		if err != nil {
+			return 0, false
+		}
+		count = max(count, int64(n))
+	}
+	return (count*6+4)/5 + 4096, true
+}
+
+var desktopDiagnosticMu sync.Mutex
+
+// DesktopDiagnostic accepts structural/numeric facts only. No prompt, tool
+// output, provider error message, headers, credentials or response body is saved.
+func DesktopDiagnostic(fields map[string]any) {
+	path := os.Getenv("CODEX_HARNESS_DIAGNOSTICS")
+	if path == "" || os.Getenv("CODEX_DESKTOP_COMPAT") != "1" {
+		return
+	}
+	desktopDiagnosticMu.Lock()
+	defer desktopDiagnosticMu.Unlock()
+	fields["at"] = time.Now().UTC().Format(time.RFC3339Nano)
+	data, err := json.Marshal(fields)
+	if err != nil {
+		return
+	}
+	if info, err := os.Stat(path); err == nil && info.Size() > 5*1024*1024 {
+		_ = os.Rename(path, path+".previous")
+	}
+	f, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	defer func() { _ = f.Close() }()
+	_, _ = f.Write(append(data, '\n'))
+}
+
+func DesktopFailureSummary(model string, request []byte, status int, phase string) {
+	if model != "muse-spark-1.3-contributor" && model != "grok-4.6" {
+		return
+	}
+	// Phase is a call-site constant; do not put upstream text into this field.
+	DesktopDiagnostic(map[string]any{"event": "upstream_failure", "model": model, "status": status,
+		"phase": strings.TrimSpace(phase), "request_bytes": len(request),
+		"input_items": len(gjson.GetBytes(request, "input").Array()), "tool_entries": len(gjson.GetBytes(request, "tools").Array())})
+}
+
+func DesktopMuseCompatibilityEnabled(model string) bool {
+	return model == "muse-spark-1.3-contributor" && os.Getenv("CODEX_DESKTOP_COMPAT") == "1"
+}
+
+func DesktopRetryableBootstrap(model string, status int) bool {
+	if !DesktopMuseCompatibilityEnabled(model) {
+		return false
+	}
+	switch status {
+	case 500, 502, 503, 504:
+		return true
+	}
+	return false
+}
+
+// Repair already-handled empty-argument calls when resuming an older task.
+// Only calls with a recorded result are eligible; no pending action is created.
+func NormalizeDesktopMuseRequestArguments(model string, body []byte) []byte {
+	if !DesktopMuseCompatibilityEnabled(model) {
+		return body
+	}
+	outputs := make(map[string]bool)
+	items := gjson.GetBytes(body, "input").Array()
+	for _, item := range items {
+		if item.Get("type").String() == "function_call_output" && item.Get("call_id").String() != "" {
+			outputs[item.Get("call_id").String()] = true
+		}
+	}
+	count := 0
+	for i, item := range items {
+		if item.Get("type").String() == "function_call" && outputs[item.Get("call_id").String()] && strings.TrimSpace(item.Get("arguments").String()) == "" {
+			body, _ = sjson.SetBytes(body, "input."+strconv.Itoa(i)+".arguments", "{}")
+			count++
+		}
+	}
+	if count > 0 {
+		DesktopDiagnostic(map[string]any{"event": "empty_historical_arguments_normalized", "model": model, "count": count})
+	}
+	return body
+}
