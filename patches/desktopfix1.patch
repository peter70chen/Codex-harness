+package cliproxy
+
+import (
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDesktopNativeModels(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	os.Mkdir(filepath.Join(home, ".codex"), 0700)
+	data := `{"models":[{"slug":"gpt-existing","context_window":1},{"slug":"gpt-missing","context_window":123456,"supported_reasoning_levels":[{"effort":"low"},{"effort":"high"}]},{"slug":"other-provider"}]}`
+	if err := os.WriteFile(filepath.Join(home, ".codex", "models_cache.json"), []byte(data), 0600); err != nil {
+		t.Fatal(err)
+	}
+	original := []*ModelInfo{{ID: "gpt-existing", ContextLength: 999}}
+	a := &coreauth.Auth{Provider: "codex", Metadata: map[string]any{"desktop_native_auth": true}}
+	got := desktopNativeModels(a, original)
+	if len(got) != 2 || got[0] != original[0] || got[1].ID != "gpt-missing" || got[1].ContextLength != 123456 || len(got[1].Thinking.Levels) != 2 {
+		t.Fatal("native model merge failed")
+	}
+	a.Metadata = nil
+	if len(desktopNativeModels(a, original)) != 1 {
+		t.Fatal("ordinary provider modified")
+	}
+}
