diff --git a/internal/runtime/executor/desktop_native_auth.go b/internal/runtime/executor/desktop_native_auth.go
new file mode 100644
index 0000000..28665e2
--- /dev/null
+++ b/internal/runtime/executor/desktop_native_auth.go
@@ -0,0 +1,51 @@
+package executor
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// desktopNativeAuth borrows only the current native access token. Codex remains
+// the sole owner of refresh-token rotation; no credentials are persisted here.
+func desktopNativeAuth(auth *cliproxyauth.Auth) (*cliproxyauth.Auth, error) {
+	if auth == nil || auth.Metadata["desktop_native_auth"] != true {
+		return auth, nil
+	}
+	fail := func() (*cliproxyauth.Auth, error) {
+		return nil, statusErr{code: 401, msg: "native Codex login unavailable; sign in to Codex on this computer"}
+	}
+	if os.Getenv("CODEX_DESKTOP_COMPAT") != "1" || auth.Provider != "codex" {
+		return fail()
+	}
+	if auth.Attributes["api_key"] != "" || auth.Attributes["base_url"] != "" || auth.Metadata["base_url"] != nil {
+		return fail()
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return fail()
+	}
+	raw, err := os.ReadFile(filepath.Join(home, ".codex", "auth.json"))
+	if err != nil {
+		return fail()
+	}
+	var native struct {
+		Mode   string `json:"auth_mode"`
+		Tokens struct {
+			Access  string `json:"access_token"`
+			Account string `json:"account_id"`
+		} `json:"tokens"`
+	}
+	if json.Unmarshal(raw, &native) != nil || native.Mode != "chatgpt" || native.Tokens.Access == "" || native.Tokens.Account == "" {
+		return fail()
+	}
+	clone := auth.Clone()
+	clone.Metadata["access_token"] = native.Tokens.Access
+	clone.Metadata["account_id"] = native.Tokens.Account
+	delete(clone.Metadata, "refresh_token")
+	delete(clone.Metadata, "id_token")
+	delete(clone.Metadata, "expired")
+	return clone, nil
+}
