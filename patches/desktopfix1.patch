@@ -0,0 +1,57 @@
+package executor
+
+import (
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCodexDesktopNativeAuth(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	if err := os.Mkdir(filepath.Join(home, ".codex"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(home, ".codex", "auth.json")
+	write := func(token, account string) {
+		t.Helper()
+		if err := os.WriteFile(p, []byte(`{"auth_mode":"chatgpt","tokens":{"access_token":"`+token+`","account_id":"`+account+`","refresh_token":"never-copy"}}`), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	a := &cliproxyauth.Auth{Provider: "codex", Metadata: map[string]any{"desktop_native_auth": true}}
+	write("first-access", "first-account")
+	b, err := desktopNativeAuth(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b.Metadata["access_token"] != "first-access" || b.Metadata["account_id"] != "first-account" || b.Metadata["refresh_token"] != nil || a.Metadata["access_token"] != nil {
+		t.Fatal("credentials not isolated")
+	}
+	write("rotated-access", "second-account")
+	b, err = desktopNativeAuth(a)
+	if err != nil || b.Metadata["access_token"] != "rotated-access" || b.Metadata["account_id"] != "second-account" {
+		t.Fatal("did not read current native login")
+	}
+	a.Attributes = map[string]string{"base_url": "https://other-provider.invalid"}
+	if _, err = desktopNativeAuth(a); err == nil {
+		t.Fatal("must reject external endpoint")
+	}
+	a.Attributes = nil
+	t.Setenv("CODEX_DESKTOP_COMPAT", "0")
+	if _, err = desktopNativeAuth(a); err == nil {
+		t.Fatal("must require opt-in")
+	}
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	os.Remove(p)
+	if _, err = desktopNativeAuth(a); err == nil || strings.Contains(err.Error(), home) {
+		t.Fatal("missing login must fail closed without private details")
+	}
+	ordinary := &cliproxyauth.Auth{Provider: "codex", Metadata: map[string]any{"access_token": "unchanged"}}
+	if b, err = desktopNativeAuth(ordinary); err != nil || b != ordinary {
+		t.Fatal("ordinary auth changed")
+	}
+}
