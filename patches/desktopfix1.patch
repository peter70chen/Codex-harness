+package helps
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestDesktopCompatHostedUsage(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	request := []byte(`{"instructions":"Follow the user","input":[{"role":"user","content":"Search the documentation"}],"tools":[{"type":"web_search"}]}`)
+	for _, model := range []string{"grok-4.6", "muse-spark-1.3-contributor"} {
+		s := NewDesktopResponsesCompat(model, request, request)
+		data := []byte(`{"type":"response.completed","response":{"output":[{"type":"web_search_call","id":"w1"}],"usage":{"input_tokens":800000,"input_tokens_details":{"cached_tokens":790000,"cache_write_tokens":1000},"output_tokens":123,"output_tokens_details":{"reasoning_tokens":45},"total_tokens":800123}}}`)
+		out := s.Apply(data)
+		n := gjson.GetBytes(out, "response.usage.input_tokens").Int()
+		if n < 4096 || n > 5000 {
+			t.Fatalf("unexpected estimate %d", n)
+		}
+		if gjson.GetBytes(out, "response.usage.total_tokens").Int() != n+123 {
+			t.Fatal("inconsistent total")
+		}
+		if gjson.GetBytes(out, "response.provider_usage.total_tokens").Int() != 800123 {
+			t.Fatal("provider accounting lost")
+		}
+		if gjson.GetBytes(out, "response.usage.output_tokens_details.reasoning_tokens").Int() != 45 {
+			t.Fatal("reasoning changed")
+		}
+		if gjson.GetBytes(out, "response.usage.input_tokens_details.cached_tokens").Int() > n {
+			t.Fatal("cache exceeds input")
+		}
+		if gjson.GetBytes(out, "response.usage.input_tokens_details.cache_write_tokens").Int() != 0 {
+			t.Fatal("cache write exceeds remaining input")
+		}
+	}
+}
+
+func TestDesktopCompatDoesNotHideRealContextOrUnsupportedInputs(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	data := []byte(`{"type":"response.completed","response":{"output":[{"type":"web_search_call"}],"usage":{"input_tokens":10000,"output_tokens":50,"total_tokens":10050}}}`)
+	cases := []string{
+		`{"input":[{"role":"user","content":"` + strings.Repeat("long history ", 10000) + `"}]}`,
+		`{"previous_response_id":"hidden","input":"hello"}`,
+		`{"input":[{"type":"message","content":[{"type":"input_image","image_url":"data:image/png;base64,AAAA"}]}]}`,
+		`{"input":[{"type":"compaction","encrypted_content":"hidden"}]}`,
+	}
+	for _, request := range cases {
+		s := NewDesktopResponsesCompat("grok-4.6", []byte(request), []byte(request))
+		if !bytes.Equal(s.Apply(data), data) {
+			t.Fatal("unsupported/large input was discounted")
+		}
+	}
+	s := NewDesktopResponsesCompat("grok-4.6", []byte(`{"input":"hello"}`), []byte(`{"input":"hello"}`))
+	plain := bytes.ReplaceAll(data, []byte(`[{"type":"web_search_call"}]`), []byte(`[]`))
+	if !bytes.Equal(s.Apply(plain), plain) {
+		t.Fatal("non-agentic usage was changed")
+	}
+}
+
+func TestDesktopCompatNamespaceSSEAndTerminal(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	request := []byte(`{"input":"hello","tools":[{"type":"namespace","name":"apps.github","tools":[{"type":"function","name":"_search"}]}]}`)
+	s := NewDesktopResponsesCompat("muse-spark-1.3-contributor", request, request)
+	frame := []byte("event: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\",\"name\":\"apps.github._search\",\"call_id\":\"call_1\",\"arguments\":\"{}\"}}\n\n")
+	out := s.Apply(frame)
+	if !bytes.Contains(out, []byte(`"namespace":"apps.github"`)) || !bytes.Contains(out, []byte(`"name":"_search"`)) || !bytes.Contains(out, []byte(`"call_id":"call_1"`)) {
+		t.Fatalf("bad namespace mapping: %s", out)
+	}
+	terminal := []byte(`{"type":"response.completed","response":{"output":[{"type":"function_call","name":"apps.github._search","call_id":"call_1","arguments":"{}"}]}}`)
+	if gjson.GetBytes(s.Apply(terminal), "response.output.0.namespace").String() != "apps.github" {
+		t.Fatal("terminal not normalized")
+	}
+}
+
+func TestDesktopCompatNamespaceAmbiguityAndScope(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	request := []byte(`{"tools":[{"type":"function","name":"ns.f"},{"type":"namespace","name":"ns","tools":[{"type":"function","name":"f"}]}]}`)
+	data := []byte(`{"type":"response.output_item.done","item":{"type":"function_call","name":"ns.f","arguments":"{}"}}`)
+	s := NewDesktopResponsesCompat("muse-spark-1.3-contributor", request, request)
+	if !bytes.Equal(s.Apply(data), data) {
+		t.Fatal("top-level name collision rewritten")
+	}
+	for _, model := range []string{"gpt-6-astra", "glm-5.3-flash", "gemini-3.8-flash-high"} {
+		if NewDesktopResponsesCompat(model, request, request) != nil {
+			t.Fatal("unrelated model modified")
+		}
+	}
+	t.Setenv("CODEX_DESKTOP_COMPAT", "")
+	if NewDesktopResponsesCompat("grok-4.6", request, request) != nil {
+		t.Fatal("opt-in ignored")
+	}
+}
+
+func TestDesktopCompatEmptyArguments(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	s := NewDesktopResponsesCompat("muse-spark-1.3-contributor", []byte(`{}`), []byte(`{}`))
+	added := []byte(`{"type":"response.output_item.added","item":{"type":"function_call","name":"lookup","arguments":""}}`)
+	if !bytes.Equal(s.Apply(added), added) {
+		t.Fatal("stream placeholder changed")
+	}
+	done := bytes.ReplaceAll(added, []byte("output_item.added"), []byte("output_item.done"))
+	if gjson.GetBytes(s.Apply(done), "item.arguments").String() != "{}" {
+		t.Fatal("empty completed arguments remain invalid JSON")
+	}
+	invalid := bytes.ReplaceAll(done, []byte(`"arguments":""`), []byte(`"arguments":"not json"`))
+	if !bytes.Equal(s.Apply(invalid), invalid) {
+		t.Fatal("non-empty malformed arguments silently fabricated")
+	}
+	if !DesktopRetryableBootstrap("muse-spark-1.3-contributor", 500) || DesktopRetryableBootstrap("muse-spark-1.3-contributor", 400) || DesktopRetryableBootstrap("gpt-6-astra", 500) {
+		t.Fatal("incorrect retry scope")
+	}
+}
+
+func TestDesktopCompatHandledHistoryOnly(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	body := []byte(`{"input":[{"type":"function_call","call_id":"done","arguments":""},{"type":"function_call_output","call_id":"done","output":"Missing required argument"},{"type":"function_call","call_id":"pending","arguments":""}]}`)
+	out := NormalizeDesktopMuseRequestArguments("muse-spark-1.3-contributor", body)
+	if gjson.GetBytes(out, "input.0.arguments").String() != "{}" || gjson.GetBytes(out, "input.2.arguments").String() != "" || gjson.GetBytes(out, "input.1.output").String() != "Missing required argument" {
+		t.Fatal("history repair changed pending call or tool result")
+	}
+}
+
+func TestDesktopDiagnosticOmitsSensitiveRequest(t *testing.T) {
+	t.Setenv("CODEX_DESKTOP_COMPAT", "1")
+	p := filepath.Join(t.TempDir(), "diagnostics.jsonl")
+	t.Setenv("CODEX_HARNESS_DIAGNOSTICS", p)
+	DesktopFailureSummary("muse-spark-1.3-contributor", []byte(`{"input":"PRIVATE_SENTINEL","tools":[]}`), 500, "http_response")
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(b, []byte("PRIVATE_SENTINEL")) || !bytes.Contains(b, []byte(`"status":500`)) {
+		t.Fatal("invalid redacted diagnostic")
+	}
+	info, _ := os.Stat(p)
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("diagnostic is not private")
+	}
+}
